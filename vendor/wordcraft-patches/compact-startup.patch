+    fn bridge_state(&self) -> Result<wasm_bindgen::JsValue, String> {
+        let state = js_sys::Object::new();
+        js_sys::Reflect::set(&state, &wasm_bindgen::JsValue::from_str("revision"), &wasm_bindgen::JsValue::from_f64(self.app.session.rev() as f64))
+            .map_err(|e| format!("{e:?}"))?;
+        js_sys::Reflect::set(&state, &wasm_bindgen::JsValue::from_str("documentId"), &wasm_bindgen::JsValue::from_f64(self.app.session.document_id() as f64))
+            .map_err(|e| format!("{e:?}"))?;
+        js_sys::Reflect::set(&state, &wasm_bindgen::JsValue::from_str("dirty"), &wasm_bindgen::JsValue::from_bool(self.app.session.dirty))
+            .map_err(|e| format!("{e:?}"))?;
+        Ok(state.into())
+    }
+
+    fn resolve(resolve: &js_sys::Function, value: &wasm_bindgen::JsValue) {
+        if let Err(e) = resolve.call1(&wasm_bindgen::JsValue::UNDEFINED, value) {
+            log::error!("couldn't resolve WordCraft bridge promise: {e:?}");
+        }
+    }
+
+    fn reject(reject: &js_sys::Function, error: impl AsRef<str>) {
+        if let Err(e) = reject.call1(&wasm_bindgen::JsValue::UNDEFINED, &wasm_bindgen::JsValue::from_str(error.as_ref())) {
+            log::error!("couldn't reject WordCraft bridge promise: {e:?}");
+        }
+    }
+
+    fn fulfill_bridge(&mut self) {
+        let requests = std::mem::take(&mut *self.bridge.borrow_mut());
+        for request in requests {
+            match request {
+                BridgeRequest::Export { name, resolve, reject } => match wordcraft_engine::io::save_bytes(&name, &self.app.session.doc) {
+                    Ok(bytes) => Self::resolve(&resolve, &js_sys::Uint8Array::from(bytes.as_slice())),
+                    Err(error) => Self::reject(&reject, error),
+                },
+                BridgeRequest::Load { name, bytes, resolve, reject } => {
+                    let data = wordcraft_engine::cmd::insert::base64_encode(&bytes);
+                    match self.app.execute("file.open", json!({"path": name, "data": data})) {
+                        Ok(_) => {
+                            self.snapshots.clear();
+                            match self.bridge_state() {
+                                Ok(state) => Self::resolve(&resolve, &state),
+                                Err(error) => Self::reject(&reject, error),
+                            }
+                        }
+                        Err(error) => Self::reject(&reject, error),
+                    }
+                }
+                BridgeRequest::Snapshot { name, resolve, reject } => match wordcraft_engine::io::save_bytes(&name, &self.app.session.doc) {
+                    Ok(bytes) => {
+                        let revision = self.app.session.rev();
+                        let document_id = self.app.session.document_id();
+                        self.snapshots.insert(revision, document_id);
+                        match self.bridge_state() {
+                            Ok(snapshot) => {
+                                if let Err(e) = js_sys::Reflect::set(&snapshot, &wasm_bindgen::JsValue::from_str("bytes"), &js_sys::Uint8Array::from(bytes.as_slice())) {
+                                    Self::reject(&reject, format!("{e:?}"));
+                                } else {
+                                    Self::resolve(&resolve, &snapshot);
+                                }
+                            }
+                            Err(error) => Self::reject(&reject, error),
+                        }
+                    }
+                    Err(error) => Self::reject(&reject, error),
+                },
+                BridgeRequest::State { resolve, reject } => match self.bridge_state() {
+                    Ok(state) => Self::resolve(&resolve, &state),
+                    Err(error) => Self::reject(&reject, error),
+                },
+                BridgeRequest::Acknowledge { revision, resolve, reject: _ } => {
+                    let current_document = self.app.session.document_id();
+                    let acknowledged = self.app.session.rev() == revision && self.snapshots.get(&revision).is_some_and(|id| *id == current_document);
+                    if acknowledged {
+                        self.app.session.dirty = false;
+                    }
+                    Self::resolve(&resolve, &wasm_bindgen::JsValue::from_bool(acknowledged));
+                }
+            }
+        }
+    }
 }
 
