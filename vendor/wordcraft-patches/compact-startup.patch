+            |ui, app: &mut WordApp| {
+                let ctx = ui.ctx().clone();
+                app.logic(&ctx);
+                app.ui(ui);
+            },
+            app,
+        );
+        let double_click_at = |h: &mut egui_kittest::Harness<'_, WordApp>, pos: egui::Pos2| {
+            let click = |h: &mut egui_kittest::Harness<'_, WordApp>, pressed: bool| {
+                h.event(egui::Event::PointerButton {
+                    pos,
+                    button: egui::PointerButton::Primary,
+                    pressed,
+                    modifiers: egui::Modifiers::NONE,
+                });
+            };
+            h.event(egui::Event::PointerMoved(pos));
+            h.step();
+            click(h, true);
+            h.step();
+            click(h, false);
+            h.step();
+            click(h, true);
+            h.step();
+            click(h, false);
+            h.run_steps(2);
+        };
+        h.run_steps(2);
+        assert!(h.state().ui.ribbon_collapsed);
+        h.get_by_label("Show Ribbon").click();
+        h.run_steps(2);
+        assert!(!h.state().ui.ribbon_collapsed, "clicking Show Ribbon expands the toolbar");
+
+        h.get_by_label("Collapse the Ribbon").click();
+        h.run_steps(2);
+        assert!(h.state().ui.ribbon_collapsed, "clicking Collapse the Ribbon collapses it again");
+
+        h.get_by_label("Insert").click();
+        h.run_steps(2);
+        assert!(!h.state().ui.ribbon_collapsed, "single-clicking a tab when collapsed opens the ribbon");
+        assert_eq!(h.state().ui.tab, "Insert");
+
+        h.run_steps(40);
+        let home = h.get_by_label("Home").rect().center();
+        double_click_at(&mut h, home);
+        assert!(h.state().ui.ribbon_collapsed, "double-clicking a tab when expanded collapses the ribbon");
+        assert_eq!(h.state().ui.tab, "Home");
+
+        h.run_steps(40);
