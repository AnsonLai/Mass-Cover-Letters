+fn install_bridge(bridge: BridgeQueue, ctx: egui::Context) -> Result<(), String> {
+    let window = web_sys::window().ok_or("no window")?;
+    let export_bridge = bridge.clone();
+    let export_ctx = ctx.clone();
+    let export = wasm_bindgen::closure::Closure::<dyn FnMut(String) -> js_sys::Promise>::new(move |name: String| {
+        let bridge = export_bridge.clone();
+        let ctx = export_ctx.clone();
+        let name = name.clone();
+        js_sys::Promise::new(&mut move |resolve, reject| {
+            bridge.borrow_mut().push(BridgeRequest::Export { name: name.clone(), resolve, reject });
+            ctx.request_repaint();
+        })
+    });
+    js_sys::Reflect::set(&window, &wasm_bindgen::JsValue::from_str("wordcraftExport"), export.as_ref())
+        .map_err(|e| format!("{e:?}"))?;
+    export.forget();
+    let load_bridge = bridge.clone();
+    let load_ctx = ctx.clone();
+    let load = wasm_bindgen::closure::Closure::<dyn FnMut(String, js_sys::Uint8Array) -> js_sys::Promise>::new(move |name: String, bytes: js_sys::Uint8Array| {
+        let bridge = load_bridge.clone();
+        let ctx = load_ctx.clone();
+        js_sys::Promise::new(&mut move |resolve, reject| {
+            bridge.borrow_mut().push(BridgeRequest::Load { name: name.clone(), bytes: bytes.to_vec(), resolve, reject });
+            ctx.request_repaint();
+        })
+    });
+    js_sys::Reflect::set(&window, &wasm_bindgen::JsValue::from_str("wordcraftLoad"), load.as_ref())
+        .map_err(|e| format!("{e:?}"))?;
+    load.forget();
+    let snapshot_bridge = bridge.clone();
+    let snapshot_ctx = ctx.clone();
+    let snapshot = wasm_bindgen::closure::Closure::<dyn FnMut(String) -> js_sys::Promise>::new(move |name: String| {
+        let bridge = snapshot_bridge.clone();
+        let ctx = snapshot_ctx.clone();
+        js_sys::Promise::new(&mut move |resolve, reject| {
+            bridge.borrow_mut().push(BridgeRequest::Snapshot { name: name.clone(), resolve, reject });
+            ctx.request_repaint();
+        })
+    });
+    js_sys::Reflect::set(&window, &wasm_bindgen::JsValue::from_str("wordcraftSnapshot"), snapshot.as_ref())
+        .map_err(|e| format!("{e:?}"))?;
+    snapshot.forget();
+    let state_bridge = bridge.clone();
+    let state_ctx = ctx.clone();
+    let state = wasm_bindgen::closure::Closure::<dyn FnMut() -> js_sys::Promise>::new(move || {
+        let bridge = state_bridge.clone();
+        let ctx = state_ctx.clone();
+        js_sys::Promise::new(&mut move |resolve, reject| {
+            bridge.borrow_mut().push(BridgeRequest::State { resolve, reject });
+            ctx.request_repaint();
+        })
+    });
+    js_sys::Reflect::set(&window, &wasm_bindgen::JsValue::from_str("wordcraftState"), state.as_ref())
+        .map_err(|e| format!("{e:?}"))?;
+    state.forget();
+    let acknowledge_bridge = bridge.clone();
+    let acknowledge_ctx = ctx.clone();
+    let acknowledge = wasm_bindgen::closure::Closure::<dyn FnMut(f64) -> js_sys::Promise>::new(move |revision: f64| {
+        let bridge = acknowledge_bridge.clone();
+        let ctx = acknowledge_ctx.clone();
+        js_sys::Promise::new(&mut move |resolve, reject| {
+            bridge.borrow_mut().push(BridgeRequest::Acknowledge { revision: revision as u64, resolve, reject });
+            ctx.request_repaint();
+        })
+    });
+    js_sys::Reflect::set(&window, &wasm_bindgen::JsValue::from_str("wordcraftAcknowledgeSave"), acknowledge.as_ref())
+        .map_err(|e| format!("{e:?}"))?;
+    acknowledge.forget();
+    Ok(())
